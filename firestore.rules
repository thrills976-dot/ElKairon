rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isVerified() { return request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function isValidUser(data) {
      return data.keys().hasAll(['role', 'name', 'email'])
        && data.role in ['candidate', 'employer']
        && data.name is string && data.name.size() <= 100
        && data.email is string && data.email.size() <= 150;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId
        && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId
        && isValidUser(incoming())
        && incoming().role == existing().role;
    }

    function isEmployer() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employer';
    }
    
    function isValidJob(data) {
      return data.keys().hasAll(['employerId', 'title', 'location', 'status'])
        && data.employerId is string && data.employerId.size() <= 128
        && data.title is string && data.title.size() <= 150
        && data.location is string && data.location.size() <= 100
        && data.status in ['active', 'closed'];
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.employerId == request.auth.uid || request.auth.token.firebase.sign_in_provider != null);
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
    
    function isValidApplication(data) {
      return data.keys().hasAll(['candidateId', 'jobId', 'status'])
        && data.candidateId is string && data.candidateId.size() <= 128
        && data.jobId is string && data.jobId.size() <= 128
        && data.status in ['pending', 'reviewed', 'interview', 'accepted', 'rejected'];
    }

    match /applications/{applicationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}
