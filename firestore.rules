rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'thrills976@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isRegisteredEmployer() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/employers/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employer')
      );
    }

    // User Private Profiles (Users can ONLY read and write their own record)
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Candidate Dossiers (Candidates write only their own; Employers/Admins can view talent pool)
    match /candidates/{candidateId} {
      allow get: if isOwner(candidateId) || isRegisteredEmployer() || isAdmin();
      allow list: if isRegisteredEmployer() || isAdmin();
      allow create: if isOwner(candidateId) && isValidId(candidateId);
      allow update: if (isOwner(candidateId) || isAdmin()) && isValidId(candidateId);
      allow delete: if isOwner(candidateId) || isAdmin();
    }

    // Employer Profiles (Employers write only their own record; signed in users can view employer details)
    match /employers/{employerId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(employerId) && isValidId(employerId);
      allow update: if (isOwner(employerId) || isAdmin()) && isValidId(employerId);
      allow delete: if isOwner(employerId) || isAdmin();
    }

    // Job Postings (Publicly readable, created/managed only by the publishing employer)
    match /jobs/{jobId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.employerId == request.auth.uid && isValidId(jobId);
      allow update: if isSignedIn() && (resource.data.employerId == request.auth.uid || isAdmin()) && isValidId(jobId);
      allow delete: if isSignedIn() && (resource.data.employerId == request.auth.uid || isAdmin());
    }

    // Job Applications (Confidential - accessible strictly to applicant candidate or hiring employer)
    match /applications/{applicationId} {
      allow get: if isSignedIn() && (
        resource.data.candidateId == request.auth.uid || 
        resource.data.employerId == request.auth.uid || 
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.candidateId == request.auth.uid || 
        resource.data.employerId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.candidateId == request.auth.uid && isValidId(applicationId);
      allow update: if isSignedIn() && (
        resource.data.candidateId == request.auth.uid || 
        resource.data.employerId == request.auth.uid || 
        isAdmin()
      ) && isValidId(applicationId);
      allow delete: if isSignedIn() && (
        resource.data.candidateId == request.auth.uid || 
        resource.data.employerId == request.auth.uid || 
        isAdmin()
      );
    }
  }
}
