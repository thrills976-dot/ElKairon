{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile containing role and basic info.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["candidate", "employer"] },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "company": { "type": "string", "maxLength": 150 },
        "title": { "type": "string", "maxLength": 100 },
        "industry": { "type": "string", "maxLength": 100 },
        "experience": { "type": "string", "maxLength": 50 },
        "size": { "type": "string", "maxLength": 50 },
        "countries": { "type": "array", "items": { "type": "string" } },
        "skills": { "type": "array", "items": { "type": "string" } },
        "cvUrl": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["role", "name", "email", "createdAt", "updatedAt"]
    },
    "Job": {
      "title": "Job Posting",
      "description": "A job posted by an employer",
      "type": "object",
      "properties": {
        "employerId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 5000 },
        "location": { "type": "string", "maxLength": 100 },
        "industry": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["active", "closed"] },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["employerId", "title", "description", "location", "status", "createdAt", "updatedAt"]
    },
    "Application": {
      "title": "Job Application",
      "description": "A candidate's application to a job",
      "type": "object",
      "properties": {
        "candidateId": { "type": "string", "maxLength": 128 },
        "jobId": { "type": "string", "maxLength": 128 },
        "employerId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["pending", "reviewed", "accepted", "rejected"] },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["candidateId", "jobId", "employerId", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles"
    },
    "jobs/{jobId}": {
      "schema": { "$ref": "#/entities/Job" },
      "description": "Stores job postings"
    },
    "applications/{applicationId}": {
      "schema": { "$ref": "#/entities/Application" },
      "description": "Stores job applications"
    }
  }
}
